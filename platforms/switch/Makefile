# ---------------------------------------------------------------------------
# The Minish Cap — Nintendo Switch (libnx homebrew) build.
#
# Compiles the same source graph as the xmake `tmc_pc` target (mirrored in
# sources.mk, regenerated by gen_sources.py) for aarch64-none-elf, links
# libnx + switch-sdl2, and packages an .nro.
#
# Run from the devkitPro MSYS2 shell (so DEVKITPRO=/opt/devkitpro is mounted):
#     make -C platforms/switch -j8
# or via the helper:  bash platforms/switch/build.sh
# ---------------------------------------------------------------------------

ifeq ($(strip $(DEVKITPRO)),)
$(error DEVKITPRO is not set. Run from the devkitPro MSYS2 shell.)
endif

PORTLIBS := $(DEVKITPRO)/portlibs/switch
LIBNX    := $(DEVKITPRO)/libnx
PREFIX   := $(DEVKITPRO)/devkitA64/bin/aarch64-none-elf-

CC  := $(PREFIX)gcc
CXX := $(PREFIX)g++

ROOT     := ../..

# ---------------------------------------------------------------------------
# Region selection. Build one .nro per region, each with its own object dir,
# embedded romfs cache, title and (for BR) default overlay language:
#     make REGION=USA   -> tmc_switch_usa.nro  (BZME, USA assets)
#     make REGION=EU    -> tmc_switch_eu.nro   (BZMP, EU  assets)
#     make REGION=BR    -> tmc_switch_br.nro   (BZMP, EU  assets, PT-BR overlay)
# The Brazilian cart is byte-identical to the European ROM (game code BZMP),
# so BR compiles with the EU game define + EU offset headers but ships its own
# romfs_br cache and BR branding. GAME_VER drives the -D<ver> define and the
# build/<ver> offset-header include; REGION drives everything user-facing.
# ---------------------------------------------------------------------------
REGION    ?= USA
REGION_LC := $(shell echo $(REGION) | tr A-Z a-z)

# Each region builds for its own ROM (game code BZME).
#   USA -> baserom.gba     (BZME, US cart)
#   BR  -> baserom_br.gba  (the romsportugues T1.0 PT-BR translation — a USA-based
#          hack, game code BZME) → builds on the USA engine path (GAME_VER=USA)
#          with BR-translated assets + a default PT-BR overlay.
# (The genuine European cart BZMP is NOT supported: the upstream 999sian port's
# EU support is incomplete — it renders the intro then faults. The region-aware
# tooling to regenerate EU data lives in tools/generate_*.py if revisited.)
ifeq ($(REGION),BR)
GAME_VER       := USA
REGION_DEFINES := -DTMC_DEFAULT_LANG_PT
APP_TITLE      := The Minish Cap (BR)
else ifeq ($(REGION),USA)
GAME_VER       := USA
REGION_DEFINES :=
APP_TITLE      := The Minish Cap
else
$(error Unknown REGION '$(REGION)' — use USA or BR)
endif

# Per-region object dir + target so the three builds never share .o files
# (they compile with different -D defines and offset headers).
BUILD    := build/$(REGION)
TARGET   := tmc_switch_$(REGION_LC)

# Build flavour: RELEASE=0 (default) is the debug build — writes tmc.log /
# applet.log / render_pool.log to the SD and keeps -g debug symbols. RELEASE=1
# is the GitHub/distribution build — defines TMC_RELEASE so all SD logging is
# compiled out (less SD wear, no per-frame I/O) and drops -g (smaller .nro).
#   make            -> debug   (logs on)
#   make RELEASE=1  -> release (logs off, stripped)
RELEASE ?= 0

include sources.mk

# The baked compile-time ROM tables (port_rom_tables.c — kSpritePtrEntries,
# kAreaRoomHeaderOffsets, kFrameObjListsData, ...) are USA ROM offsets. An EU
# build must link EU-correct tables or it calls garbage function pointers and
# faults at AgbMain (gSpriteAnimations_322 -> 0 entries -> Instruction Abort).
# For GAME_VER=EU, swap in the region-generated port_rom_tables_eu.c (produced
# by tools/generate_rom_tables.py emit EU). Same symbol names, so exactly one is
# compiled. USA/BR (BZME) keep the committed USA tables.
ARCH := -march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -ftls-model=local-exec -fPIE

DEFINES := -D__SWITCH__ -DPC_PORT -DNON_MATCHING -D$(GAME_VER) -DENGLISH -DREVISION=0 \
           -DFMT_HEADER_ONLY=1 -DTMC_PC_VERSION=\"0.2.1.1\" -DTMC_PORT_VERSION=\"0.2.1.1\" \
           -DMODE1_GBA_WIDTH=288 -DCURL_STATICLIB -DTMC_GPU_RENDER $(REGION_DEFINES)
# Add -DTMC_PERF to enable the frame profiler (switch_perf.c → perf.log).

# Release flavour: define TMC_RELEASE (gates SD logging in the C/C++ sources).
ifeq ($(RELEASE),1)
DEFINES += -DTMC_RELEASE
DEBUGFLAG :=
else
DEBUGFLAG := -g
endif
# ^ widescreen EXPERIMENT (iteration 1): render 288px wide (~16:9). The engine
# still only fills a 256px BG tilemap, so the right strip glitches until Half B
# (512px tilemap + engine column fill) lands — see WIDESCREEN_PLAN.md.

# Order matters: compat/ (SDL3->SDL2 redirect) BEFORE the SDL2 include dir.
INCLUDES := -Icompat \
            -isystem $(PORTLIBS)/include/SDL2 \
            -I$(ROOT)/include -I$(ROOT) -I$(ROOT)/port \
            -I$(ROOT)/libs -I$(ROOT)/libs/ViruaPPU/include \
            -I$(ROOT)/libs/VirtuaAPU/include -I$(ROOT)/libs/agbplay_core \
            -I$(ROOT)/build/$(GAME_VER) -I$(ROOT)/tools/src/assets_extractor \
            -I$(ROOT)/libs/rcheevos/include -I$(ROOT)/libs/rcheevos/src \
            -I$(PORTLIBS)/include -isystem $(LIBNX)/include

WARN := -Wall -Wno-unknown-pragmas -Wno-unused -Wno-format

CFLAGS   := $(DEBUGFLAG) -O2 -ffunction-sections -fdata-sections $(ARCH) $(DEFINES) $(INCLUDES) $(WARN) -D_REENTRANT
CFLAGS   += -std=gnu11
CXXFLAGS := $(DEBUGFLAG) -O2 -ffunction-sections -fdata-sections $(ARCH) $(DEFINES) $(INCLUDES) $(WARN) -D_REENTRANT
CXXFLAGS += -std=gnu++20

LDFLAGS := -specs=$(LIBNX)/switch.specs $(DEBUGFLAG) $(ARCH) -Wl,--gc-sections \
           -L$(PORTLIBS)/lib -L$(LIBNX)/lib
# switch-sdl2 pulls in the Mesa/EGL stack + libnx (see sdl2-config --libs).
# -lcurl uses the libnx TLS backend (system CA store, no bundled certs); it must
# precede -lnx so the ssl-service symbols resolve. mbedtls* supply the crypto.
# See `curl-config --libs`: -lcurl -lnx -lz. Needed for HTTPS (RetroAchievements,
# issue #12). Compiled with -DCURL_STATICLIB (DEFINES) for the static link.
LIBS := -lSDL2 -lpng -lz -lEGL -lglapi -ldrm_nouveau \
        -lcurl -lmbedtls -lmbedx509 -lmbedcrypto \
        -lnx -lpthread -lm

# Switch-only support sources (ViruaPPU patch-symbol stub, romfs bootstrap,
# libnx-thread parallel-for + background runner for on-device extraction,
# applet lifecycle = docked resolution + HOME/sleep audio pause).
SWITCH_SRCS := switch_stubs.c switch_romfs.c switch_parallel.c switch_applet.c \
               switch_render_pool.c switch_net.c switch_perf.c switch_nxlink.c \
               compat/sdl3_debug_text.c

# rcheevos (RetroAchievements, issue #12) — vendored submodule, ROOT-relative so
# the $(ROOT)/%.c rule builds them. Pure C, no external deps; _WIN32 is undefined
# so it takes the POSIX time/pthread path (libnx-backed). Omitted: rc_libretro.c
# (libretro-specific) and rc_client_raintegration.c (Windows toolkit only).
RCHEEVOS_SRCS := \
	port/port_retroachievements.c \
	libs/rcheevos/src/rc_client.c \
	libs/rcheevos/src/rc_compat.c \
	libs/rcheevos/src/rc_util.c \
	libs/rcheevos/src/rc_version.c \
	libs/rcheevos/src/rapi/rc_api_common.c \
	libs/rcheevos/src/rapi/rc_api_editor.c \
	libs/rcheevos/src/rapi/rc_api_info.c \
	libs/rcheevos/src/rapi/rc_api_runtime.c \
	libs/rcheevos/src/rapi/rc_api_user.c \
	libs/rcheevos/src/rcheevos/alloc.c \
	libs/rcheevos/src/rcheevos/condition.c \
	libs/rcheevos/src/rcheevos/condset.c \
	libs/rcheevos/src/rcheevos/consoleinfo.c \
	libs/rcheevos/src/rcheevos/format.c \
	libs/rcheevos/src/rcheevos/lboard.c \
	libs/rcheevos/src/rcheevos/memref.c \
	libs/rcheevos/src/rcheevos/operand.c \
	libs/rcheevos/src/rcheevos/rc_validate.c \
	libs/rcheevos/src/rcheevos/richpresence.c \
	libs/rcheevos/src/rcheevos/runtime_progress.c \
	libs/rcheevos/src/rcheevos/runtime.c \
	libs/rcheevos/src/rcheevos/trigger.c \
	libs/rcheevos/src/rcheevos/value.c \
	libs/rcheevos/src/rhash/aes.c \
	libs/rcheevos/src/rhash/cdreader.c \
	libs/rcheevos/src/rhash/hash_disc.c \
	libs/rcheevos/src/rhash/hash_encrypted.c \
	libs/rcheevos/src/rhash/hash_rom.c \
	libs/rcheevos/src/rhash/hash_zip.c \
	libs/rcheevos/src/rhash/hash.c \
	libs/rcheevos/src/rhash/md5.c

# Optional embedded romfs (pre-baked asset cache). Populated by
# build_extractor.sh into ./romfs/. If present, elf2nro bundles it so the .nro
# is self-contained and the user only needs to supply baserom.gba.
ROMFS_DIR := romfs_$(REGION_LC)
ROMFS_ARG := $(if $(wildcard $(ROMFS_DIR)/*),--romfsdir=$(ROMFS_DIR),)

# Port-side sources not (yet) listed in sources.mk. port_scene_trace.c provides
# Port_SceneTrace_Emit() behind the SCENE_LOG() macro (issue #28 room/transition
# tracing). SCENE_LOG is live on the debug build (PC_PORT && !TMC_RELEASE) and a
# no-op header otherwise, so the .o is empty on release but the symbol must be
# linkable on debug — game.c/room.c/script.c reference it. ROOT-relative.
PORT_SRCS := port/port_scene_trace.c

OBJS := $(addprefix $(BUILD)/, $(SWITCH_SRCS:.c=.o)) \
        $(addprefix $(BUILD)/, $(RCHEEVOS_SRCS:.c=.o)) \
        $(addprefix $(BUILD)/, $(PORT_SRCS:.c=.o)) \
        $(addprefix $(BUILD)/, $(C_SOURCES:.c=.o)) \
        $(addprefix $(BUILD)/, $(CPP_SOURCES:.cpp=.o))

DEPS := $(OBJS:.o=.d)

.PHONY: all clean nro
all: $(TARGET).nro

nro: $(TARGET).nro

# APP_TITLE is set per-REGION near the top of this file.
APP_AUTHOR  := zeldaret/999sian — Switch port
APP_VERSION := 0.2.1.1
APP_ICON    := $(if $(wildcard icon.jpg),icon.jpg,$(LIBNX)/default_icon.jpg)

$(TARGET).nacp:
	@echo "[nacptool] $@"
	@nacptool --create "$(APP_TITLE)" "$(APP_AUTHOR)" "$(APP_VERSION)" $@

$(TARGET).nro: $(TARGET).elf $(TARGET).nacp
	@echo "[elf2nro] $@ $(if $(ROMFS_ARG),(+romfs),)"
	@elf2nro $< $@ --nacp=$(TARGET).nacp --icon=$(APP_ICON) $(ROMFS_ARG)

$(TARGET).elf: $(OBJS)
	@echo "[link] $@"
	$(CXX) $(LDFLAGS) $(OBJS) $(LIBS) -o $@

# Switch-only sources live in this dir.
$(BUILD)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

# Repo sources are reached through $(ROOT).
$(BUILD)/%.o: $(ROOT)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/%.o: $(ROOT)/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -MMD -MP -c $< -o $@

clean:
	rm -rf $(BUILD) $(TARGET).elf $(TARGET).nro $(TARGET).nacp

-include $(DEPS)
